;; Format a nonzero shortest decimal using ECMAScript's fixed/scientific
;; cutovers. Allocate the final UTF-16 array once, prefilled with ASCII zeros.
(func $gc_decimal_text (param $v i64) (param $power i32) (param $sign i32) (result (ref null $gc_key))
  (local $digits i32) (local $remaining i64) (local $point i32)
  (local $start i32) (local $dot i32) (local $end i32) (local $size i32)
  (local $exponent i32) (local $magnitude i32) (local $exponent_digits i32)
  (local $key (ref null $gc_key)) (local $i i32)
  (local.set $remaining (local.get $v))
  (loop $count
    (local.set $digits (i32.add (local.get $digits) (i32.const 1)))
    (local.set $remaining (i64.div_u (local.get $remaining) (i64.const 10)))
    (br_if $count (i64.ne (local.get $remaining) (i64.const 0))))
  (local.set $point (i32.add (local.get $digits) (local.get $power)))
  (local.set $start (local.get $sign))
  (local.set $dot (i32.const -1))
  (if (i32.or (i32.le_s (local.get $point) (i32.const -6)) (i32.gt_s (local.get $point) (i32.const 21)))
    (then
      ;; d.ddde+NN or d.ddde-NN
      (local.set $exponent (i32.sub (local.get $point) (i32.const 1)))
      (local.set $magnitude (select (i32.sub (i32.const 0) (local.get $exponent)) (local.get $exponent)
                                    (i32.lt_s (local.get $exponent) (i32.const 0))))
      (local.set $exponent_digits (i32.add (i32.const 1)
        (i32.add (i32.ge_u (local.get $magnitude) (i32.const 10))
                 (i32.ge_u (local.get $magnitude) (i32.const 100)))))
      (if (i32.gt_u (local.get $digits) (i32.const 1))
        (then (local.set $dot (i32.add (local.get $start) (i32.const 1))))))
    (else (if (i32.le_s (local.get $point) (i32.const 0))
      (then (local.set $start (i32.sub (i32.add (local.get $sign) (i32.const 2)) (local.get $point))))
      (else (if (i32.lt_s (local.get $point) (local.get $digits))
        (then (local.set $dot (i32.add (local.get $sign) (local.get $point)))))))))
  (local.set $end (i32.add (i32.add (local.get $start) (local.get $digits))
                           (i32.ge_s (local.get $dot) (i32.const 0))))
  (local.set $size (local.get $end))
  (if (local.get $exponent_digits)
    (then (local.set $size (i32.add (local.get $end) (i32.add (i32.const 2) (local.get $exponent_digits)))))
    (else (if (i32.gt_s (local.get $power) (i32.const 0))
      (then (local.set $size (i32.add (local.get $size) (local.get $power)))))))
  (local.set $key (array.new $gc_key (i32.const 48) (local.get $size)))
  (if (local.get $sign) (then (array.set $gc_key (local.get $key) (i32.const 0) (i32.const 45))))
  (if (i32.gt_u (local.get $start) (local.get $sign))
    (then (array.set $gc_key (local.get $key) (i32.add (local.get $sign) (i32.const 1)) (i32.const 46))))
  (if (i32.ge_s (local.get $dot) (i32.const 0))
    (then (array.set $gc_key (local.get $key) (local.get $dot) (i32.const 46))))
  (local.set $i (local.get $end))
  (loop $significand
    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
    (if (i32.eq (local.get $i) (local.get $dot))
      (then (local.set $i (i32.sub (local.get $i) (i32.const 1)))))
    (array.set $gc_key (local.get $key) (local.get $i)
      (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
    (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
    (br_if $significand (i64.ne (local.get $v) (i64.const 0))))
  (if (local.get $exponent_digits) (then
    (array.set $gc_key (local.get $key) (local.get $end) (i32.const 101))
    (array.set $gc_key (local.get $key) (i32.add (local.get $end) (i32.const 1))
      (select (i32.const 45) (i32.const 43) (i32.lt_s (local.get $exponent) (i32.const 0))))
    (local.set $i (local.get $size))
    (loop $write_exponent
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (array.set $gc_key (local.get $key) (local.get $i)
        (i32.add (i32.const 48) (i32.rem_u (local.get $magnitude) (i32.const 10))))
      (local.set $magnitude (i32.div_u (local.get $magnitude) (i32.const 10)))
      (br_if $write_exponent (local.get $magnitude)))))
  (local.get $key))

(func $gc_number_text (param $value f64) (result (ref null $gc_key))
  (local $bits i64) (local $fraction i64) (local $biased i32) (local $sign i32)
  (local.set $bits (i64.reinterpret_f64 (local.get $value)))
  (local.set $fraction (i64.and (local.get $bits) (i64.const 0xfffffffffffff)))
  (local.set $biased (i32.and (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 52))) (i32.const 2047)))
  (local.set $sign (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 63))))
  (if (i32.eq (local.get $biased) (i32.const 2047)) (then
    (if (i64.ne (local.get $fraction) (i64.const 0))
      (then (return (array.new_fixed $gc_key 3 (i32.const 78) (i32.const 97) (i32.const 78)))))
    (if (local.get $sign)
      (then (return (array.new_fixed $gc_key 9 (i32.const 45) (i32.const 73) (i32.const 110) (i32.const 102)
        (i32.const 105) (i32.const 110) (i32.const 105) (i32.const 116) (i32.const 121)))))
    (return (array.new_fixed $gc_key 8 (i32.const 73) (i32.const 110) (i32.const 102)
      (i32.const 105) (i32.const 110) (i32.const 105) (i32.const 116) (i32.const 121)))))
  (if (f64.eq (local.get $value) (f64.const 0))
    (then (return (array.new_fixed $gc_key 1 (i32.const 48)))))
  ;; Exact small integers are common array indices, loop counters and IDs.
  (if (i32.and (f64.eq (local.get $value) (f64.trunc (local.get $value)))
               (f64.le (f64.abs (local.get $value)) (f64.const 9007199254740991)))
    (then (return (call $gc_decimal_text (i64.trunc_f64_u (f64.abs (local.get $value)))
                                         (i32.const 0) (local.get $sign)))))
  (call $ryu_decimal (local.get $fraction) (local.get $biased))
  (local.get $sign)
  (call $gc_decimal_text))

(func $gc_primitive_string (param $value (ref null $gc_value)) (result (ref null $gc_value))
  (if (i32.eq (struct.get $gc_value 0 (local.get $value)) (i32.const 3)) (then
    (return (struct.new $gc_value (i32.const 5) (f64.const 0)
      (call $gc_number_text (struct.get $gc_value 1 (local.get $value)))))))
  (call $gc_scalar_string (local.get $value)))
