(component
  ;; Replaced as a binary section with exact outline_guest bytes before validation.
  ;; Keep this unnamed, empty slot first so all later module indices stay unchanged.
  (core module)
  (import "grunkalunka:markdown/documents" (instance $documents
    (type $error (enum "denied" "too-large" "unknown-grant"))
    (export "read-error" (type $read-error (eq $error)))
    (export "document" (type $document (sub resource)))
    (export "[method]document.read"
      (func (param "self" (borrow $document)) (result (result string (error $read-error)))))
  ))
  (alias export $documents "document" (type $document))
  (type $error (enum "denied" "too-large" "unknown-grant" "outline-too-large"))
  (export $public-error "inspect-error" (type $error))
  (type $heading (record
    (field "level" u8) (field "start" u32) (field "end" u32)
    (field "section-end" u32) (field "parent" (option u32)) (field "text" string)))
  (export $public-heading "heading" (type $heading))

  (core instance $guest (instantiate 0))
  (core module $storage
    (import "guest" "outline_begin" (func $begin))
    (memory (export "memory") 1 1)
    (global $allocated (mut i32) (i32.const 0))
    (global $cleanups (mut i32) (i32.const 0))
    ;; Only the imported read allocates here: one UTF-8 string of at most 4096 bytes.
    (func (export "realloc") (param $old i32) (param $old-size i32)
      (param $align i32) (param $size i32) (result i32)
      (if (i32.or (i32.or (local.get $old) (local.get $old-size))
            (i32.or (i32.ne (local.get $align) (i32.const 1))
              (i32.or (i32.gt_u (local.get $size) (i32.const 4096)) (global.get $allocated))))
        (then unreachable))
      (global.set $allocated (i32.const 1))
      (i32.const 1024))
    (func (export "cleanup") (param $result i32)
      (if (local.get $result) (then unreachable))
      (memory.fill (i32.const 0) (i32.const 0) (i32.const 65536))
      (call $begin)
      (global.set $allocated (i32.const 0))
      (global.set $cleanups (i32.add (global.get $cleanups) (i32.const 1))))
    (func (export "cleanup-count") (result i32) (global.get $cleanups))
  )
  (core instance $storage (instantiate $storage (with "guest" (instance $guest))))
  (core func $read (canon lower (func $documents "[method]document.read")
    (memory (core memory $storage "memory")) (realloc (core func $storage "realloc"))))
  (core func $drop-document (canon resource.drop $document))
  (core module $adapter
    (import "storage" "memory" (memory 1 1))
    (import "host" "read" (func $read (param i32 i32)))
    (import "host" "drop-document" (func $drop-document (param i32)))
    (import "guest" "outline_begin" (func $begin))
    (import "guest" "outline_push" (func $push (param i32) (result i32)))
    (import "guest" "outline_finish" (func $finish (result i32)))
    (import "guest" "outline_field" (func $field (param i32 i32) (result i32)))
    (import "guest" "outline_text_byte" (func $byte (param i32 i32) (result i32)))
    (func $error (param $code i32) (result i32)
      (i32.store (i32.const 0) (i32.const 1))
      (i32.store (i32.const 4) (local.get $code))
      (i32.const 0))
    (func $compute (param $document i32) (result i32)
      (local $ptr i32) (local $len i32) (local $i i32) (local $j i32)
      (local $count i32) (local $record i32) (local $parent i32)
      (local $text i32) (local $value i32)
      (call $begin)
      (call $read (local.get $document) (i32.const 16))
      (if (i32.load8_u (i32.const 16))
        (then (return (call $error (i32.load8_u (i32.const 20))))))
      (local.set $ptr (i32.load (i32.const 20)))
      (local.set $len (i32.load (i32.const 24)))
      (if (i32.gt_u (local.get $len) (i32.const 4096)) (then unreachable))
      (loop $input
        (if (i32.lt_u (local.get $i) (local.get $len)) (then
          (if (call $push (i32.load8_u (i32.add (local.get $ptr) (local.get $i)))) (then unreachable))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $input))))
      (local.set $count (call $finish))
      (if (i32.eq (local.get $count) (i32.const -4))
        (then (return (call $error (i32.const 3)))))
      (if (i32.gt_u (local.get $count) (i32.const 64)) (then unreachable))
      (local.set $i (i32.const 0))
      (local.set $text (i32.const 16384))
      ;; Canonical heading records: stride 32, parent at 16/20, text at 24/28.
      (loop $headings
        (if (i32.lt_u (local.get $i) (local.get $count)) (then
          (local.set $record (i32.add (i32.const 8192) (i32.mul (local.get $i) (i32.const 32))))
          (local.set $j (i32.const 0))
          (loop $fields
            (i32.store (i32.add (local.get $record) (i32.mul (local.get $j) (i32.const 4)))
              (call $field (local.get $i) (local.get $j)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br_if $fields (i32.lt_u (local.get $j) (i32.const 4))))
          (local.set $parent (call $field (local.get $i) (i32.const 4)))
          (i32.store offset=16 (local.get $record) (i32.ne (local.get $parent) (i32.const -1)))
          (i32.store offset=20 (local.get $record) (local.get $parent))
          (local.set $len (call $field (local.get $i) (i32.const 5)))
          (if (i32.gt_u (local.get $len) (i32.sub (i32.const 20480) (local.get $text))) (then unreachable))
          (i32.store offset=24 (local.get $record) (local.get $text))
          (i32.store offset=28 (local.get $record) (local.get $len))
          (local.set $j (i32.const 0))
          (loop $label
            (if (i32.lt_u (local.get $j) (local.get $len)) (then
              (local.set $value (call $byte (local.get $i) (local.get $j)))
              (if (i32.gt_u (local.get $value) (i32.const 255)) (then unreachable))
              (i32.store8 (i32.add (local.get $text) (local.get $j)) (local.get $value))
              (local.set $j (i32.add (local.get $j) (i32.const 1)))
              (br $label))))
          (local.set $text (i32.add (local.get $text) (local.get $len)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $headings))))
      (i32.store (i32.const 0) (i32.const 0))
      (i32.store (i32.const 4) (i32.const 8192))
      (i32.store (i32.const 8) (local.get $count))
      (i32.const 0))
    (func (export "inspect") (param $document i32) (result i32)
      (local $result i32)
      (local.set $result (call $compute (local.get $document)))
      (call $drop-document (local.get $document))
      (local.get $result))
  )
  (core instance $entry (instantiate $adapter
    (with "guest" (instance $guest)) (with "storage" (instance $storage))
    (with "host" (instance (export "read" (func $read)) (export "drop-document" (func $drop-document))))))
  (func (export "inspect") (param "document" (borrow $document))
    (result (result (list $public-heading) (error $public-error)))
    (canon lift (core func $entry "inspect") (memory (core memory $storage "memory"))
      (post-return (core func $storage "cleanup"))))
  (func (export "cleanup-count") (result u32) (canon lift (core func $storage "cleanup-count")))
)
