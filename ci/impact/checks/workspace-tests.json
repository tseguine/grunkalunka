{
  "id": "check:workspace-tests",
  "command": "cargo",
  "args": [
    "test",
    "--workspace",
    "--locked",
    "--offline",
    "-j",
    "4",
    "--no-fail-fast"
  ],
  "dependsOn": [],
  "scope": "workspace",
  "pr": {
    "reason": "PRs retain all non-runtime tests plus the explicitly classified fast runtime targets; exhaustive runtime matrices run in the full profile.",
    "commands": [
      {
        "command": "node",
        "args": [
          "scripts/pr-cargo-tests.mjs"
        ]
      }
    ]
  },
  "paths": [
    "scripts/pr-cargo-tests.mjs"
  ],
  "masterGroup": "rust-tests"
}
