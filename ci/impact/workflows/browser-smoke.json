{
  "id": "workflow:browser-smoke",
  "file": ".github/workflows/browser-smoke.yml",
  "paths": [
    "tests/browser-oracles/**",
    "tools/browser-oracles/**",
    ".github/workflows/browser-smoke.yml"
  ],
  "requiredFor": [
    "tests/browser-oracles/**",
    "tools/browser-oracles/**"
  ],
  "mustContain": [
    "engine: [chromium, firefox, webkit]",
    "mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea",
    "node --test tools/browser-oracles/hosted/smoke.test.mjs",
    "node --test tools/browser-oracles/hosted/cross-engine.test.mjs"
  ]
}
